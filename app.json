{
  "expo": {
    "name": "SleepPet",
    "slug": "SleepPet",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#1B1B4B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1B1B4B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gathod.SleepPet",
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSleepPetNative",
      "expo-font",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Permite medir tu pulso antes de dormir (fotopletismografia con la camara trasera y flash)"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1c5cc861-6b9a-40d1-959d-d324ddb09b13"
      }
    }
  }
}
